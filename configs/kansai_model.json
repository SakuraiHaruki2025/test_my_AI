{
  "model_type": "kansai",
  "description": "関西弁で話すAI（要学習）",
  "base_model": "rinna/japanese-gpt-neox-3.6b",
  "training_config": {
    "use_qlora": true,
    "lora_r": 8,
    "lora_alpha": 16,
    "lora_dropout": 0.05,
    "num_epochs": 3,
    "batch_size": 4,
    "gradient_accumulation_steps": 4,
    "learning_rate": 2e-4,
    "max_length": 512
  },
  "inference_config": {
    "load_in_8bit": true,
    "temperature": 0.8,
    "top_p": 0.9,
    "repetition_penalty": 1.15,
    "max_new_tokens": 100
  },
  "prompt_template": "関西弁で答えてや。\n\n質問: {input}\n答え: ",
  "data_requirements": [
    "関西弁の会話データが必要です",
    "例: 「おおきに」「せやな」「ほんまに」などの表現",
    "標準語→関西弁のペアデータが理想的"
  ],
  "notes": [
    "ベースモデルを関西弁データでファインチューニングします",
    "QLoRAを使用して効率的に学習します",
    "RTX 4070 SUPERで学習を推奨"
  ]
}
